{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "variable",
	"windowSizingY": "variable",
	"windowMinWidth": 694,
	"windowMinHeight": 480,
	"windowTitle": "Order desk - Orders",
	"pages": [
		{
			"objects": {}
		},
		{
			"objects": {
				"btnAdd": {
					"type": "button",
					"text": "Add",
					"top": 20,
					"left": 20,
					"width": 80,
					"height": 28,
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/btnAdd.4dm",
					"tooltip": "New order",
					"style": "regular"
				},
				"btnEdit": {
					"type": "button",
					"text": "Edit",
					"top": 20,
					"left": 110,
					"width": 80,
					"height": 28,
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/btnEdit.4dm",
					"tooltip": "Edit order",
					"style": "regular"
				},
				"btnDrop": {
					"type": "button",
					"text": "Delete",
					"top": 20,
					"left": 200,
					"width": 80,
					"height": 28,
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/btnDrop.4dm",
					"tooltip": "Delete order",
					"style": "regular"
				},
				"ListOrders": {
					"type": "listbox",
					"left": 20,
					"top": 68,
					"width": 674,
					"height": 392,
					"listboxType": "collection",
					"dataSource": "Form.orders",
					"currentItemSource": "Form.selectedOrder",
					"selectionMode": "single",
					"events": [
						"onSelectionChange",
						"onDoubleClick"
					],
					"hideFocusRing": true,
					"scrollbarHorizontal": "automatic",
					"scrollbarVertical": "automatic",
					"sizingY": "grow",
					"sizingX": "grow",
					"columns": [
						{
							"name": "Order",
							"dataSource": "This.orderNumber",
							"header": {
								"text": "Order",
								"name": "Header1"
							},
							"width": 80,
							"footer": {
								"name": "Footer1"
							},
							"minWidth": 80,
							"maxWidth": 200
						},
						{
							"name": "Customer",
							"dataSource": "This.customer",
							"header": {
								"text": "Customer",
								"name": "Header2"
							},
							"width": 200,
							"footer": {
								"name": "Footer2"
							},
							"minWidth": 120,
							"maxWidth": 300
						},
						{
							"name": "Status",
							"dataSource": "This.status",
							"header": {
								"text": "Status",
								"name": "Header3"
							},
							"width": 130,
							"footer": {
								"name": "Footer3"
							},
							"minWidth": 120,
							"maxWidth": 300
						},
						{
							"name": "Total",
							"dataSource": "This.total",
							"header": {
								"text": "Total",
								"name": "Header4"
							},
							"width": 120,
							"footer": {
								"name": "Footer4"
							},
							"minWidth": 120,
							"maxWidth": 300
						},
						{
							"name": "Date",
							"dataSource": "This.date",
							"dataSourceTypeHint": "date",
							"dateFormat": "abbreviated",
							"header": {
								"text": "Date",
								"name": "Header5"
							},
							"width": 120,
							"footer": {
								"name": "Footer5"
							},
							"minWidth": 120,
							"maxWidth": 300
						}
					]
				},
